[Unit]
Description=Jianlian Liuhaoyi Alipay account recharge recovery watcher dry-run
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/www/jianlian-shop
EnvironmentFile=/etc/jianlian/liuhaoyi-alipay-recovery.env
TimeoutStartSec=45s
ReadWritePaths=/run/lock
ExecStart=/usr/bin/flock -n -E 0 /run/lock/jianlian-liuhaoyi-alipay-recovery.lock /bin/sh -c 'exec "$$JIANLIAN_NODE_BINARY" "$$JIANLIAN_RELEASE_DIR/scripts/ops/liuhaoyi-alipay-recharge-watcher.mjs" --watcher-lock-held'
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
