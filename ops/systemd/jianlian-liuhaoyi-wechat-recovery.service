[Unit]
Description=Jianlian Liuhaoyi WeChat recharge recovery watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/www/jianlian-shop
EnvironmentFile=/etc/jianlian/liuhaoyi-wechat-recovery.env
TimeoutStartSec=45s
ReadWritePaths=/run/lock
ExecStart=/usr/bin/flock -n -E 0 /run/lock/jianlian-liuhaoyi-wechat-recovery.lock /bin/sh -c 'exec "$$JIANLIAN_NODE_BINARY" "$$JIANLIAN_RELEASE_DIR/scripts/ops/liuhaoyi-wechat-recharge-watcher.mjs" --watcher-lock-held --execute'
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
